<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Algorithm-Viusaliser.Testing\SortingTests.cs">
        <Link>UnitTesting\SortingTests.cs</Link>
      </Compile>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests/**" />
        <Content Remove="tests/**" />
        <None Remove="tests/**" />
        <EmbeddedResource Remove="tests/**" />
    </ItemGroup>

</Project>
